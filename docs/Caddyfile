example.com {
	root * /var/www/streetview
	encode zstd gzip
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@layers path /deep-layers/*
	header @layers Cache-Control "public, max-age=86400"

	# the drawing server
	handle /api/* {
		reverse_proxy 127.0.0.1:8787
	}
	handle /ws {
		reverse_proxy 127.0.0.1:8787
	}
	# places (/colosseum): the page with the title and picture for chat apps; the plain page if that fails
	@place {
		path_regexp ^/[\w-]+$
		not path /explore /privacy /terms
		not file
	}
	handle @place {
		reverse_proxy 127.0.0.1:8787 {
			@failed status 5xx
			handle_response @failed {
				rewrite * /index.html
				file_server
			}
		}
	}
	handle_errors {
		@page path_regexp ^/[\w-]+$
		handle @page {
			rewrite * /index.html
			file_server {
				status 200
			}
		}
	}

	# data files: real 404s
	handle /deep-layers/* {
		file_server
	}
	handle {
		try_files {path} /index.html
		file_server
	}
}
