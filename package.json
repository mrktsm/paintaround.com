{
  "name": "paintaround",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --force && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "pool:sample": "node scripts/sample-panorama-pool.mjs",
    "pool:expand": "node scripts/sample-panorama-pool.mjs --expanded --limit=200",
    "pool:verify": "node scripts/verify-panorama-pool.mjs",
    "pool:thumbnails": "node scripts/generate-panorama-thumbnails.mjs",
    "pool:loading-previews": "node scripts/generate-panorama-loading-previews.mjs",
    "paint:materials": "node scripts/generate-paint-materials.mjs",
    "server": "node server/realtime.ts",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.node.json",
    "test": "node --test 'tests/{server,unit}/*.test.ts'",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "mapillary-js": "^4.1.2",
    "maplibre-gl": "^5.17.0",
    "perfect-freehand": "^1.2.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "sharp": "^0.34.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
