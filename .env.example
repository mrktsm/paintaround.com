# Settings of the drawing server (server/realtime.ts). All optional: without any, it runs on
# 127.0.0.1:8787 for the dev site, with moderation off.

# Where it listens, and the sites that may connect to it (comma-separated)
#PORT=8787
#HOST=127.0.0.1
#ALLOWED_ORIGINS=https://example.com

# The photos, for previews and moderation
#PANO_DIR=/path/to/panorama-pool/

# Moderation with Gemini: off without a key. MODERATION: off, log (decide, change nothing) or on
#GEMINI_API_KEY=
#MODERATION=log
#MODERATION_MAX_PER_HOUR=2000

# Phone alerts through ntfy when something is held or removed. Anyone who knows the topic can read
# them: make it long and random.
#NTFY_TOPIC=
